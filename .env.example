# Wallet App - Docker environment example

# PostgreSQL
POSTGRES_DB=wallet_app
POSTGRES_USER=wallet_app
POSTGRES_PASSWORD=change_this_password

# ------------------------------------------------------------
# PostgreSQL data directory
# Use ONLY one POSTGRES_DATA_DIR depending on the environment.
# ------------------------------------------------------------

# Windows - Development with Docker Desktop
POSTGRES_DATA_DIR=./.docker-data/postgres

# Ubuntu Server - Production
# POSTGRES_DATA_DIR=/srv/postgres/wallet-app